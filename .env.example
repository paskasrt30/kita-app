PORT=3000
JWT_SECRET=ganti_dengan_random_string_yang_panjang_dan_aman

# Koneksi Postgres (Vercel Storage -> Postgres, tab ".env.local" di dashboard project,
# atau connection string dari Neon/Supabase kalau pakai provider lain)
POSTGRES_URL=

# SMTP untuk kirim email verifikasi (opsional — jika kosong, verifikasi email dilewati)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Google OAuth untuk Login dengan Google (opsional)
# Dapatkan dari https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
